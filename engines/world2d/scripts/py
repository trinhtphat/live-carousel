#!/bin/sh
# Python with numpy for the sound step: the shared env, the live engine's env, or a system python3 with numpy.
D="$(cd "$(dirname "$0")/.." && pwd)"
V="${MC_HOME:-$HOME/.motion-carousels}/venv"
if [ -x "$V/bin/python" ]; then exec "$V/bin/python" "$@"; fi
if [ -x "$V/Scripts/python.exe" ]; then exec "$V/Scripts/python.exe" "$@"; fi
if [ -x "$D/../live/scripts/py" ] && "$D/../live/scripts/py" -c "import numpy" 2>/dev/null; then exec "$D/../live/scripts/py" "$@"; fi
for p in python3 python; do command -v "$p" >/dev/null 2>&1 && "$p" -c "import numpy" 2>/dev/null && exec "$p" "$@"; done
echo "No Python with numpy: run the skill's scripts/setup.sh" >&2; exit 1
